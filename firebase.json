{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**/*.vcf",
        "headers": [
          {
            "key": "Content-Type",
            "value": "text/vcard; charset=utf-8"
          },
          {
            "key": "Content-Disposition",
            "value": "inline; filename=\"Mateo-Villarreal-Sanchez.vcf\""
          }
        ]
      },
      {
        "source": "**/*.@(jpg|jpeg|png|webp|svg)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=604800"
          }
        ]
      }
    ]
  }
}
